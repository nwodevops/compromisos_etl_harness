<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_main_windows</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Windows: Reset H2 → Python STG → stage sheets → Run Python</description>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/08/05 10:00:00.000</created_date>
  <modified_date>2026/09/26 13:20:00.000</modified_date>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>48</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>Y</set_logfile>
      <logfile>${PROJECT_HOME}/log/reset_h2</logfile>
      <logext>log</logext>
      <add_date>Y</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>Y</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>@echo off
cd /d "%PROJECT_HOME%"
call h2\scripts\reset_and_create.bat
</script>
      <name>Reset H2 clean</name>
      <description>start H2 mem + DDL</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>208</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>Y</set_logfile>
      <logfile>${PROJECT_HOME}/log/create_stg</logfile>
      <logext>log</logext>
      <add_date>Y</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>Y</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>@echo off
cd /d "%PROJECT_HOME%"
set "PY=.venv\Scripts\python.exe"
if not exist "%PY%" set "PY=python"
"%PY%" python\create_stg.py
</script>
      <name>Python create STG</name>
      <description>inputs.yaml → CREATE TABLE STG_*</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>368</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>Y</set_logfile>
      <logfile>${PROJECT_HOME}/log/stage_sheets</logfile>
      <logext>log</logext>
      <add_date>Y</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>Y</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>@echo off
cd /d "%PROJECT_HOME%"
set "PY=.venv\Scripts\python.exe"
if not exist "%PY%" set "PY=python"
"%PY%" python\stage\stage_sheets.py
</script>
      <name>Stage sheets</name>
      <description>Google Sheets → STG vía hop-run</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>528</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>Y</set_logfile>
      <logfile>${PROJECT_HOME}/log/run_python</logfile>
      <logext>log</logext>
      <add_date>Y</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>Y</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>@echo off
cd /d "%PROJECT_HOME%"
set "PY=.venv\Scripts\python.exe"
if not exist "%PY%" set "PY=python"
"%PY%" python\main.py
</script>
      <name>Run Python</name>
      <description>python/main.py → logica → Excel + DW_ACU_*</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>688</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <xloc>848</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Reset H2 clean</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Reset H2 clean</from>
      <to>Python create STG</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Python create STG</from>
      <to>Stage sheets</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Stage sheets</from>
      <to>Run Python</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run Python</from>
      <to>Success</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>Windows (cmd). Misma corrida que wf_main: Reset H2 → STG → Sheets → Python.
H2 compartido con informes: puerto 9092, mem:csep. No correr a la vez.</note>
      <markdown>N</markdown>
      <notetype>GENERAL</notetype>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>288</xloc>
      <yloc>400</yloc>
      <width>520</width>
      <height>60</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>
